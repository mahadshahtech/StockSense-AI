# StockSense AI — Environment Variables
# Copy this file to backend/.env and fill in values

# Google Gemini API key (optional — app works without it; AI assistant will show unavailable)
GEMINI_API_KEY=

# JWT secret for authentication (change in production)
JWT_SECRET=stocksense-dev-secret-change-me

# SQLite database path (relative to backend/)
DATABASE_URL=file:./data/stocksense.db

# Server port
PORT=3001

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
